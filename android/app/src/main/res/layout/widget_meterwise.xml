<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background" android:clipToOutline="true">
<ImageView android:layout_width="270dp" android:layout_height="270dp" android:layout_gravity="end|center_vertical" android:src="@drawable/widget_orbits" android:importantForAccessibility="no" android:contentDescription="@null"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical">
<TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="METERWISE / MONTH" android:textColor="#8DE6D8" android:textSize="10sp" android:letterSpacing="0.08" android:fontFamily="sans-serif-medium" android:includeFontPadding="false"/>
<TextView android:id="@+id/refresh" android:layout_width="56dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:gravity="center" android:text="Refresh" android:textColor="#C7FFF0" android:textSize="11sp" android:background="@drawable/widget_control" android:contentDescription="Refresh Meterwise data"/>
<TextView android:id="@+id/update_app" android:layout_width="56dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:gravity="center" android:text="Update" android:textColor="#F5B99B" android:textSize="11sp" android:background="@drawable/widget_control" android:contentDescription="Check for widget software updates"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical">
<TextView android:id="@+id/spend" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="—" android:textColor="#F3F6FF" android:textSize="44sp" android:fontFamily="serif" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
<TextView android:id="@+id/projection" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:maxWidth="140dp" android:text="Sign in to connect" android:textColor="#B7C9DA" android:textSize="12sp" android:gravity="end" android:maxLines="2" android:ellipsize="end" android:includeFontPadding="false"/>
</LinearLayout>
<include layout="@layout/widget_metrics"/>
<LinearLayout android:id="@+id/details" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:layout_marginTop="14dp" android:visibility="visible">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#8DE6D8" android:textSize="9sp" android:letterSpacing="0.12" android:text="PROVIDER SPEND"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:id="@+id/providers" android:layout_marginTop="5dp" android:textColor="#E1ECF8" android:textSize="12sp" android:maxLines="3" android:lineSpacingExtra="3dp" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:layout_marginTop="12dp" android:textColor="#F5B99B" android:textSize="9sp" android:letterSpacing="0.12" android:text="SYNC ACTIVITY"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:id="@+id/activity" android:layout_marginTop="5dp" android:textColor="#E1ECF8" android:textSize="12sp" android:maxLines="4" android:lineSpacingExtra="3dp" android:text="No recent syncs"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center_vertical">
<TextView android:id="@+id/updated" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Connect your backoffice" android:textColor="#9FAFC7" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Backoffice ↗" android:textColor="#8DE6D8" android:textSize="10sp" android:includeFontPadding="false"/>
</LinearLayout>
</LinearLayout></FrameLayout>
