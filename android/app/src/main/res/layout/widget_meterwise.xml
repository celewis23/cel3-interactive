<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="METERWISE" android:textColor="#38BDF8" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/refresh" android:layout_width="56dp" android:layout_height="36dp" android:gravity="center" android:text="Refresh" android:textColor="#BAE6FD" android:textSize="12sp" android:contentDescription="Refresh Meterwise data" />
    </LinearLayout>
    <TextView android:id="@+id/spend" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold" />
    <TextView android:id="@+id/projection" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Month-to-date · Sign in to connect" android:textColor="#9DAAB6" android:textSize="12sp" />
    <TextView android:id="@+id/stats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Providers —    Projects —\nDaily avg —    Sync issues —" android:textColor="#FFFFFF" android:textSize="12sp" android:lineSpacingExtra="3dp" />
    <LinearLayout android:id="@+id/details" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:layout_marginTop="12dp">
        <TextView android:id="@+id/providers" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#BAE6FD" android:textSize="12sp" android:maxLines="3" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="RECENT SYNC ACTIVITY" android:textColor="#9DAAB6" android:textSize="10sp" />
        <TextView android:id="@+id/activity" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No activity yet" android:textColor="#FFFFFF" android:textSize="12sp" android:maxLines="4" android:lineSpacingExtra="4dp" />
    </LinearLayout>
    <TextView android:id="@+id/updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Tap to open Meterwise" android:textColor="#9DAAB6" android:textSize="10sp" android:maxLines="2" />
</LinearLayout>
